  "description": "A simulated UPI-style payment system: VPAs, UPI PIN, push payments, collect requests and QR codes",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fardeen79-ops/UPI.git"
  },
  "license": "MIT",
